select d.name , count(e.id) as a from departments d join 
employees e on d.id = e.department_id
where e.age > 40
group by d.name
order by a desc
limit 1;

+------------+-----+
| name       | a   |
+------------+-----+
| Operations | 101 |
+------------+-----+

select COUNT(id) as num from employees
where joining_date >= CURDATE() - INTERVAL 100 DAY ;
Output:
+-----+
| num |
+-----+
| 100 |
+-----+

update employees e join departments d
on e.department_id = d.id
set joining_date = CURDATE() - 1
where d.name = 'HR';


select COUNT(id) as num from employees
where joining_date >= CURDATE() - INTERVAL 100 DAY ;


Output:
+-----+
| num |
+-----+
| 280 |
